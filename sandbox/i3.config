# Minimal i3 for the i3-cua Xephyr sandbox.
# No bars, no autostart execs — so pointing a nested i3 here never launches your
# real Slack/browser/etc. Mod is Alt, and only leaks to the host while the
# Xephyr window itself is focused.
set $mod Mod1
font pango:monospace 10
default_border normal 2

# Automation-friendly: don't let a pointer move (click/scroll) silently steal
# keyboard focus out from under a focus_window()+type_text() sequence.
focus_follows_mouse no

# Explicit face, not the "monospace" alias (fontconfig maps that to Noto Color
# Emoji on this box, which xterm can't render → it fails to start).
bindsym $mod+Return exec xterm -fa "DejaVu Sans Mono" -fs 11
bindsym $mod+Shift+q kill
bindsym $mod+h focus left
bindsym $mod+l focus right
bindsym $mod+v split vertical
bindsym $mod+b split horizontal
bindsym $mod+f fullscreen toggle
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+Shift+e exit
